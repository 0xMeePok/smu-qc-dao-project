{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qc-dao.local/schemas/selected-proposal-export.schema.json",
  "title": "QC DAO selected proposal export",
  "description": "JSON file returned when an administrator exports proposals and their comments, accepted or not. Grading and token distribution are not in this file. The CSV form uses x-csv-columns, one row per comment. Spreadsheet formula introducers, including those hidden behind leading whitespace/control/format characters, are prefixed with an apostrophe; JSON preserves the exact text. Small exports remain one JSON and one CSV file. Large exports use numbered JSON/CSV parts conforming to this schema and a separate completion manifest. Each part has its own counts and a partial-segment notice; retain all numbered parts and the matching completed manifest. Proposal/posting metadata can repeat across parts, so use the manifest's unique-record totals rather than summing part proposal/posting counts.",
  "x-continuation-protocol": {
    "version": 1,
    "maxCommentDocumentsPerCall": 50,
    "maxResponseUtf8Bytes": 262144,
    "maxBrowserPartUtf8Bytes": 8388608,
    "sessionLifetimeHours": 24,
    "membership": "Firestore system creation time at or before the initial query's read time; legacy application timestamps are preserved",
    "bodyConsistency": "Current body when its page is read; this is not a global point-in-time body snapshot",
    "ordering": "Complete small files preserve normalized date/ID order. Numbered parts follow proposal/document-ID traversal and are date/ID sorted internally.",
    "failure": "No completed export audit or completion manifest before terminal success. If a large export stops after downloading parts, those parts remain explicitly incomplete."
  },
  "x-schema-version": 2,
  "x-csv-columns": [
    "schemaVersion",
    "exportedAt",
    "postingId",
    "postingTitle",
    "postingSummary",
    "postingStatus",
    "postingWorkflowStatus",
    "opportunityType",
    "ownerId",
    "organisation",
    "postingAmount",
    "postingCurrency",
    "acceptedAt",
    "proposalId",
    "proposalTitle",
    "proposalSummary",
    "proposalStatus",
    "proposalWorkflowStatus",
    "accepted",
    "researcherId",
    "proposalAmount",
    "proposalCurrency",
    "proposalCategory",
    "commentId",
    "authorId",
    "authorRole",
    "badge",
    "recommendation",
    "recommendationLabel",
    "commentBody",
    "parentId",
    "commentCreatedAt",
    "commentUpdatedAt",
    "editedAt",
    "deletedAt",
    "qualifying",
    "moderationStatus"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "exportedAt",
    "scope",
    "notice",
    "postingCount",
    "proposalCount",
    "commentCount",
    "postings"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "exportedAt": { "type": "string" },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "acceptance", "proposalId", "startDate", "endDate"],
          "properties": {
            "mode": { "const": "proposal" },
            "acceptance": { "enum": ["accepted", "all"] },
            "proposalId": { "type": "string", "minLength": 1 },
            "startDate": { "type": "null" },
            "endDate": { "type": "null" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "acceptance", "proposalId", "startDate", "endDate"],
          "properties": {
            "mode": { "const": "range" },
            "acceptance": { "enum": ["accepted", "all"] },
            "proposalId": { "type": "null" },
            "startDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "endDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          }
        }
      ]
    },
    "notice": { "type": "string", "minLength": 1 },
    "postingCount": { "type": "integer", "minimum": 0 },
    "proposalCount": { "type": "integer", "minimum": 0 },
    "commentCount": { "type": "integer", "minimum": 0 },
    "postings": {
      "type": "array",
      "items": { "$ref": "#/$defs/posting" }
    }
  },
  "$defs": {
    "posting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "summary", "status", "workflowStatus", "opportunityType",
        "ownerId", "organisation", "categories", "amount", "currency",
        "createdAt", "updatedAt", "expiresAt", "acceptedAt", "proposals"
      ],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "status": { "type": "string" },
        "workflowStatus": { "type": "string" },
        "opportunityType": { "type": ["string", "null"] },
        "ownerId": { "type": "string" },
        "organisation": { "type": "string" },
        "categories": { "type": "array", "items": { "type": "string" } },
        "amount": { "type": ["number", "null"] },
        "currency": { "type": ["string", "null"] },
        "createdAt": { "type": ["string", "null"] },
        "updatedAt": { "type": ["string", "null"] },
        "expiresAt": { "type": ["string", "null"] },
        "acceptedAt": { "type": ["string", "null"] },
        "proposals": { "type": "array", "items": { "$ref": "#/$defs/proposal" } }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "summary", "status", "workflowStatus", "accepted", "researcherId",
        "amount", "currency", "category", "createdAt", "updatedAt", "comments"
      ],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "status": { "type": "string" },
        "workflowStatus": { "type": "string" },
        "accepted": { "type": "boolean" },
        "researcherId": { "type": "string" },
        "amount": { "type": ["number", "null"] },
        "currency": { "type": ["string", "null"] },
        "category": { "type": ["string", "null"] },
        "createdAt": { "type": ["string", "null"] },
        "updatedAt": { "type": ["string", "null"] },
        "comments": { "type": "array", "items": { "$ref": "#/$defs/comment" } }
      }
    },
    "comment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "authorId", "authorRole", "badge", "recommendation", "recommendationLabel",
        "body", "parentId", "createdAt", "updatedAt", "editedAt", "deletedAt",
        "qualifying", "moderationStatus"
      ],
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorRole": { "type": "string" },
        "badge": { "anyOf": [{ "type": "null" }, { "const": "evaluator" }] },
        "recommendation": {
          "anyOf": [
            { "type": "null" },
            { "enum": ["recommend", "recommend_with_revisions", "do_not_recommend"] }
          ]
        },
        "recommendationLabel": {
          "anyOf": [
            { "type": "null" },
            { "enum": ["Recommend", "Recommend with revisions", "Do not recommend"] }
          ]
        },
        "body": { "type": "string" },
        "parentId": { "type": ["string", "null"] },
        "createdAt": { "type": ["string", "null"] },
        "updatedAt": { "type": ["string", "null"] },
        "editedAt": { "type": ["string", "null"] },
        "deletedAt": { "type": ["string", "null"] },
        "qualifying": { "type": "boolean" },
        "moderationStatus": { "type": "string" }
      }
    }
  }
}
