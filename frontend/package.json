{
  "name": "qc-dao-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../firebase/functions/securityDependencies/manage.mjs --verify --production . ../firebase/functions && node scripts/seed-dev.mjs",
    "dev": "node ../firebase/functions/securityDependencies/manage.mjs --verify --production . ../firebase/functions && vite --host 127.0.0.1",
    "build": "node ../firebase/functions/securityDependencies/manage.mjs --verify --production . ../firebase/functions && vite build",
    "sync:audit-registry": "node ../firebase/functions/securityDependencies/manage.mjs --verify --production . ../firebase/functions && node scripts/sync-audit-registry.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node ../firebase/functions/securityDependencies/manage.mjs --verify --production . ../firebase/functions && node --test --test-reporter=../scripts/test-reporter.mjs test/*.test.js test/unit/*.test.js test/integration/*.test.js test/a11y/*.test.js && vitest run",
    "test:a11y": "node ../firebase/functions/securityDependencies/manage.mjs --verify --production . ../firebase/functions && node --test --test-reporter=../scripts/test-reporter.mjs test/a11y/*.test.js && vitest run test/a11y/primitives.test.jsx",
    "test:unit": "node ../firebase/functions/securityDependencies/manage.mjs --verify --production . ../firebase/functions && node --test --test-reporter=../scripts/test-reporter.mjs test/unit/*.test.js",
    "test:integration": "node ../firebase/functions/securityDependencies/manage.mjs --verify --production . ../firebase/functions && node --test --test-reporter=../scripts/test-reporter.mjs test/integration/*.test.js",
    "postinstall": "node ../firebase/functions/securityDependencies/manage.mjs --apply --production .",
    "security:apply": "node ../firebase/functions/securityDependencies/manage.mjs --apply --production .",
    "security:verify": "node ../firebase/functions/securityDependencies/manage.mjs --verify --production ."
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@privy-io/react-auth": "^3.51.2",
    "@tanstack/react-query": "^5.102.2",
    "@vitejs/plugin-react": "5.2.0",
    "firebase": "12.19.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "viem": "^2.57.8",
    "vite": "7.3.7"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "axe-core": "^4.10.3",
    "jsdom": "26.1.0",
    "vitest": "4.1.12",
    "@types/react": "^18.3.27"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "ws@^8": "8.21.0",
    "source-map-js": "1.2.2",
    "@walletconnect/ethereum-provider": "2.22.4",
    "@walletconnect/universal-provider": "2.22.4",
    "follow-redirects": "1.16.2",
    "@grpc/grpc-js": "1.14.7",
    "uuid": "11.1.1"
  }
}
