{
  "name": "qc-dao-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/seed-dev.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "sync:audit-registry": "node scripts/sync-audit-registry.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test --test-reporter=../scripts/test-reporter.mjs test/*.test.js test/unit/*.test.js test/integration/*.test.js && vitest run",
    "test:unit": "node --test --test-reporter=../scripts/test-reporter.mjs test/unit/*.test.js",
    "test:integration": "node --test --test-reporter=../scripts/test-reporter.mjs test/integration/*.test.js"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.2",
    "@vitejs/plugin-react": "5.2.0",
    "firebase": "12.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "viem": "^2.55.19",
    "vite": "6.4.3",
    "wagmi": "^3.7.6"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "jsdom": "26.1.0",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
