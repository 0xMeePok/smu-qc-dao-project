# --- Firebase web app config -------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
# reCAPTCHA Enterprise score-based site key (same value as Firebase App Check).
VITE_FIREBASE_APP_CHECK_SITE_KEY=
# Required for posting attachments (QCDAO-58). Without it the app still runs, but
# the attachment UI reports that Storage is not configured instead of uploading.
# Copy the value from Firebase console > Storage; it looks like the line below.
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# Not Used
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=

# --- Optional overrides ------------------------------------------------------
# Custom Arbitrum Sepolia RPC. Defaults to the public endpoint when blank.
VITE_ARBITRUM_SEPOLIA_RPC_URL=
# Deployed AuditRegistry address on Arbitrum Sepolia. This matches the checked-in
# frontend default and can be overridden for a later deployment.
VITE_AUDIT_REGISTRY_ADDRESS=0xd119C050E51e7012B4Dea180c3e4F2727F354447

# Point the app at local emulators instead of the deployed project.
# Requires: cd firebase && npx firebase emulators:start --only functions,firestore,auth,storage
VITE_FIREBASE_USE_EMULATORS=true
