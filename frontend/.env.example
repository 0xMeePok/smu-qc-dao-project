# --- Firebase web app config -------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
# reCAPTCHA Enterprise score-based site key (same value as Firebase App Check).
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# Not Used
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=

# --- Optional overrides ------------------------------------------------------
# Custom Arbitrum Sepolia RPC. Defaults to the public endpoint when blank.
VITE_ARBITRUM_SEPOLIA_RPC_URL=

# Point the app at local emulators instead of the deployed project.
# Requires: cd firebase && npx firebase emulators:start --only functions,firestore,auth
VITE_FIREBASE_USE_EMULATORS=false
