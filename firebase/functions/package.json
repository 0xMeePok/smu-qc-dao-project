{
  "name": "qc-dao-functions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Server-side wallet signature verification for QC DAO",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "serve": "firebase emulators:start --only functions,firestore,auth,storage",
    "deploy": "firebase deploy --only functions",
    "test": "firebase emulators:exec --config ../firebase.json --only functions,firestore,auth,storage --project qc-dao-demo \"node --test --test-concurrency=1 --test-reporter=../../scripts/test-reporter.mjs test/*.test.mjs\"",
    "test:attach": "node --test --test-concurrency=1 --test-reporter=../../scripts/test-reporter.mjs test/*.test.mjs",
    "seed": "node scripts/mock_data.mjs",
    "reset": "node scripts/reset-dev-data.mjs"
  },
  "dependencies": {
    "@privy-io/node": "0.35.0",
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "viem": "2.55.19"
  },
  "devDependencies": {
    "firebase-tools": "15.35.0"
  },
  "overrides": {
    "gaxios": {
      "uuid": "11.1.1"
    },
    "teeny-request": {
      "uuid": "11.1.1"
    },
    "firebase-tools": {
      "glob": "14.0.3",
      "@google-cloud/pubsub": "6.3.2"
    }
  }
}
