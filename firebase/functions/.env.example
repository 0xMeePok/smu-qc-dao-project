# Cloud Functions runtime environment.
#
# Copy to `.env` and fill it in. `.env` is git-ignored; this example is not, so
# never put a real key, secret or signing material in here. Secrets live in
# Secret Manager (see the handover book, Reference > Environment variables).
#
# Firebase loads `.env` first, then `.env.<project-id>`. Both are uploaded with
# the functions at deploy time, so a shell variable alone changes nothing.
# `.env.qcdao-a0c7a` is generated by scripts/preview-deploy.mjs; do not edit it.

# --- Required when deployed -------------------------------------------------

# Public Privy app id. exchangePrivySession verifies access tokens against it.
# In the emulator it is read from frontend/.env.local instead.
PRIVY_APP_ID=

# Primary RPC for receipt checks and platform transactions. CI refuses to
# deploy without it; the functions otherwise fall back to the rate-limited
# public node and fail intermittently under any load.
ARBITRUM_SEPOLIA_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# --- Optional ---------------------------------------------------------------

# Comma-separated fallback RPCs, tried in order after the primary fails.
ARBITRUM_SEPOLIA_RPC_BACKUP_URLS=

# Comma-separated emails granted administrator on first sign-in.
ADMIN_BOOTSTRAP_EMAILS=

# `true` lets sweepAttachments actually delete files. Dry run otherwise.
ATTACHMENT_SWEEP_ENABLED=

# AI drafting. AI_DRAFT_ENABLED=true spends OpenAI credit.
AI_DRAFT_ENABLED=
AI_SIMILARITY_ENABLED=
AI_DRAFT_MODEL=

# Overrides the registry address from the manifest. Must match the frontend's
# VITE_AUDIT_REGISTRY_ADDRESS. Leave blank to use the synced manifest.
AUDIT_REGISTRY_ADDRESS=

# --- Warm instances: leave BLANK unless a demo is being graded ---------------
#
# A positive number pins that many always-on instances on the six callables a
# member waits on: listActionItems, listMyProposalQueue, exchangePrivySession,
# prepareEscrowDeposit, prepareOpenFundingAction and getOpenFundingSummary.
# Blank or 0 disables it, which is the normal state.
#
# Each pinned instance is billed for every idle second whether or not anyone
# calls it. In October two pinned functions cost about USD 0.76 a day and were
# 95% of this project's Cloud Run spend. At 1 vCPU / 256 MiB in
# asia-southeast1 the price is roughly:
#
#   WARM_INSTANCES=1, six functions   ~USD 1.13 per 12 hours, ~USD 68 a month
#   WARM_INSTANCES=2, six functions   ~USD 2.27 per 12 hours
#
# While this is blank the same six stay warm from the browser's `warmup` ping
# (frontend/src/lib/prewarm.js, every two minutes per open tab) for about
# USD 0.01 per 12 hours. That is best-effort rather than guaranteed, which is
# the only reason to pay for the flag.
#
# Set it, deploy, run the demo, then clear it and deploy again:
#
#   WARM_INSTANCES=1 npx firebase deploy --only functions --project qcdao-a0c7a
#
WARM_INSTANCES=
