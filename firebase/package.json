{
  "name": "qc-dao-firebase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Firestore security rules and their tests",
  "scripts": {
    "test": "firebase emulators:exec --only firestore,storage --project qc-dao-rules-test \"node --test --test-reporter=../scripts/test-reporter.mjs test/*.test.mjs\"",
    "preemulate": "VITE_FIREBASE_USE_EMULATORS=true npm --prefix ../frontend run build && node scripts/local-hosting-config.mjs",
    "emulate": "firebase emulators:start --config firebase.local.json --only hosting,functions,firestore,auth,storage",
    "deploy:rules": "firebase deploy --only firestore:rules,storage",
    "deploy:preview": "node scripts/preview-deploy.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "firebase": "12.4.0",
    "firebase-tools": "14.27.0"
  }
}
