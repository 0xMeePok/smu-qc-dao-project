{
  "name": "qc-dao-firebase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Firestore security rules and their tests",
  "scripts": {
    "test": "firebase emulators:exec --only firestore,storage --project qc-dao-rules-test \"node --test --test-concurrency=1 --test-reporter=../scripts/test-reporter.mjs test/*.test.mjs\"",
    "preemulate": "VITE_FIREBASE_USE_EMULATORS=true npm --prefix ../frontend run build && node scripts/local-hosting-config.mjs",
    "emulate": "firebase emulators:start --config firebase.local.json --only hosting,functions,firestore,auth,storage",
    "deploy:rules": "firebase deploy --only firestore:rules,storage",
    "deploy:preview": "node scripts/preview-deploy.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.35.0"
  },
  "overrides": {
    "firebase-tools": {
      "glob": "14.0.3",
      "@google-cloud/pubsub": "6.3.2",
      "superstatic": {
        "re2": "1.27.0"
      }
    },
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.7"
    },
    "gaxios": {
      "uuid": "11.1.1"
    },
    "teeny-request": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
