rules_version = '2';

// QCDAO-58 - supporting files attached to a posting.
//
// The object path IS the authorisation record:
//
//     problems/{ownerId}/{problemId}/{fileName}
//
// `ownerId` is a wallet address, and request.auth.uid IS the lowercase wallet
// address (firebase/functions/index.js only mints a token after verifying a
// signature over a server-issued nonce - see the header of firestore.rules). So
// `request.auth.uid == ownerId` is a real ownership proof taken straight from the
// path, with no Firestore lookup on the hot path.
//
// Putting the owner in the path rather than reading problems/{problemId}.ownerId
// is what makes "remove-before-publish" work: attachments are uploaded while the
// posting is still an unsaved draft, so there is no posting document to consult
// yet. Ownership is still provable, because it is in the path being written to.
//
// Read access mirrors the problems/{problemId} read rule in firestore.rules and
// must keep mirroring it. That coupling has already bitten once: QCDAO-48 widened
// posting visibility for Discover without changing this file, so a solution
// developer could read a posting and then be refused its attachments. Change BOTH
// rules together, or the two audiences silently diverge again.
//
// ON OBJECT COUNT - what these rules can and cannot do.
// firestore.rules caps a posting's attachment list at 5, but that governs the
// posting record, not the bucket. Storage rules cannot count objects or read a
// running total, so nothing here bounds how many objects one wallet writes. Every
// per-REQUEST property is constrained (owner, type, name, size, metadata); volume
// is not expressible as a rule and is handled outside this file:
//
//   1. App Check enforcement on Cloud Storage - ENABLED. Uploads now require a
//      token from an attested instance of the real app, so a script holding a
//      valid ID token is no longer sufficient. This is what closes the abuse
//      vector; the SDK already attached the tokens, only enforcement was missing.
//   2. sweepAttachments (functions/attachmentSweeper.js) deletes objects under
//      this prefix that no posting references. Still needed WITH App Check on,
//      because most orphans are not abuse: a user who uploads and then abandons
//      the form, or closes the tab before publishing, leaves a real file behind
//      through entirely ordinary use. The client deletes what it can on abandon,
//      but it cannot clean up after a closed tab - that is this job's work.
//   3. storage.lifecycle.json aborts incomplete resumable uploads after a day.
//      Covers partial transfers only; completed orphans are (2)'s problem.
//   4. A budget alert, so anything unexpected surfaces as a notification.
service firebase.storage {
  match /b/{bucket}/o {

    // Per-file cap. Mirrored in frontend/src/lib/attachments.js as MAX_FILE_BYTES;
    // the client copy is a courtesy so the user gets an instant error, this copy is
    // the one that is actually enforced.
    function maxBytes() {
      return 10 * 1024 * 1024;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isWallet(address) {
      return isSignedIn() && request.auth.uid == address;
    }

    // Cross-service read of the same suspension/revocation state Firestore
    // enforces. Without this a suspended user, or one whose sessions were revoked
    // on logout, would keep full access to Storage using an ID token that
    // Firestore has already stopped honouring.
    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function userExists() {
      return firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function isSuspended() {
      return userExists() && userDoc().get('suspended', false);
    }

    // Inclusive comparison, matching hasRevokedSession() in firestore.rules: sign
    // in and log out inside the same whole second must still invalidate the token.
    function hasRevokedSession() {
      return (firestore.exists(/databases/(default)/documents/sessionRevocations/$(request.auth.uid))
          && request.auth.token.auth_time
            <= firestore.get(/databases/(default)/documents/sessionRevocations/$(request.auth.uid)).data.sessionsValidAfterEpoch)
        || (userExists()
          && userDoc().keys().hasAny(['sessionsValidAfterEpoch'])
          && request.auth.token.auth_time <= userDoc().sessionsValidAfterEpoch);
    }

    function isActiveWallet(address) {
      return isWallet(address) && !isSuspended() && !hasRevokedSession();
    }

    // Any signed-in wallet in good standing, whoever it belongs to. Used for
    // reading a published posting's attachments, where the caller is a member of
    // the marketplace rather than the owner of the file. userExists() is the
    // membership gate: a SIWE token without a /users profile is not enough.
    function isActiveReader() {
      return isSignedIn() && userExists() && !isSuspended() && !hasRevokedSession();
    }

    // Mirrors the problems/{problemId} read rule in firestore.rules, which since
    // QCDAO-48 makes a submitted or open posting readable by anyone - that is the
    // public marketplace Discover queries.
    //
    // The ownerId comparison is load-bearing, not decoration. Without it, anyone
    // could upload into their OWN folder using a published posting's id
    // (problems/{attacker}/{publishedId}/x.pdf) and have those bytes served to the
    // world on the strength of someone else's posting being public.
    function postingIsPublished(problemId, ownerId) {
      return firestore.exists(/databases/(default)/documents/problems/$(problemId))
        && firestore.get(/databases/(default)/documents/problems/$(problemId)).data.status
             in ['submitted', 'open']
        && firestore.get(/databases/(default)/documents/problems/$(problemId)).data.ownerId
             == ownerId;
    }

    // PDF only, per the story. Two independent checks because they can disagree:
    // contentType is metadata the client supplies, and the object name is the path
    // it writes to. Requiring both closes the case where a caller uploads
    // `payload.html` while declaring `application/pdf`, which would otherwise be
    // served back from a Firebase Storage download URL with an HTML content type.
    //
    // NOTE: neither check inspects the bytes. A determined uploader can still put
    // arbitrary content inside a correctly-named, correctly-typed object; the
    // client checks the %PDF- magic number to catch honest mistakes, but real
    // content inspection means scanning server-side, which QCDAO-58 puts out of
    // scope. That matters MORE than it used to: attachments on a published posting
    // are now readable by anyone, so a malicious file reaches every viewer rather
    // than only its uploader. The app still downloads via getBlob and never renders
    // a PDF inline, which is what keeps this to "unpleasant" rather than "hostile
    // content executing in the reader's browser". Revisit if preview is ever added.
    //
    // fileName and problemId are PARAMETERS, not free variables. Path captures are
    // bound inside their own match block, so a helper declared out here that reads
    // `fileName` directly does not see the path segment - it silently evaluates to
    // nothing and the rule denies everything, including legitimate uploads. Passing
    // them in is what keeps these usable from the match block below.
    function isPdf(fileName) {
      return request.resource.contentType == 'application/pdf'
        && fileName.matches('^[A-Za-z0-9._-]{1,120}[.]pdf$');
    }

    function withinSizeCap() {
      return request.resource.size > 0 && request.resource.size <= maxBytes();
    }

    // Lock the custom metadata the app relies on so a caller cannot write an
    // object whose recorded uploader disagrees with the path it sits in.
    function metadataIsHonest(problemId) {
      return request.resource.metadata != null
        && request.resource.metadata.uploadedBy == request.auth.uid
        && request.resource.metadata.problemId == problemId;
    }

    // The posting id is a Firestore document id, so bound it to that shape. The
    // match block already guarantees a single path segment, but nothing otherwise
    // stopped a caller from using a 300-character segment as a scratch namespace.
    function isPostingId(problemId) {
      return problemId.matches('^[A-Za-z0-9_-]{1,64}$');
    }

    match /problems/{ownerId}/{problemId}/{fileName} {
      // Same audience as the posting itself, which is what QCDAO-58 asks for:
      // "access controlled by the same role rules as the posting".
      //
      // A signed-in member (completed /users profile) can download the documents
      // on any published posting - otherwise a solution developer finds the
      // posting on Discover, sees the attachment listed, clicks Download and is
      // refused, which is the exact technical context the story exists to give
      // them. A draft stays private to its owner. Both halves match
      // firestore.rules: these PDFs carry the sponsor's competitive detail and
      // are not for the open internet, nor for a wallet that has only signed SIWE.
      allow read: if (isActiveReader() && postingIsPublished(problemId, ownerId))
        || isActiveWallet(ownerId);

      // CREATE ONLY - a stored attachment is immutable for its whole life.
      //
      // With overwrites allowed, an owner could replace an object in place after
      // the posting had been shared: an evaluator reads version 1, the owner
      // silently swaps in version 2 at the same path, and nothing in Firestore or
      // Storage records that the document under review ever changed. Attachments
      // exist to give reviewers technical context, so "the bytes behind this
      // reference never change" is a property worth having.
      //
      // Nothing legitimate is lost: uploadAttachment() mints a fresh id for every
      // transfer, so the client never writes the same path twice. Replacing a file
      // is delete-then-upload, which leaves the posting record visibly changed.
      //
      // `resource == null` is doing the real work here, NOT the absence of an
      // `update` rule. Storage classifies an overwrite of an existing object as a
      // `create`, so omitting `update` does not stop one - verified against the
      // emulator, where the swap still succeeded until this clause was added.
      // `resource` is the object already at this path, so requiring it to be null
      // is what actually makes the write create-only.
      allow create: if resource == null
        && isActiveWallet(ownerId)
        && isPostingId(problemId)
        && isPdf(fileName)
        && withinSizeCap()
        && metadataIsHonest(problemId);

      // Remove-before-publish, and removal after the fact. Restricted to the
      // owner for the same reason writes are.
      allow delete: if isActiveWallet(ownerId);
    }

    // Deny everything not matched above, including any legacy path.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
