rules_version = '2';

// QCDAO-58 - supporting files attached to a posting.
//
// The object path IS the authorisation record:
//
//     problems/{ownerId}/{problemId}/{fileName}
//
// `ownerId` is a wallet address, and request.auth.uid IS the lowercase wallet
// address (firebase/functions/index.js only mints a token after verifying a
// signature over a server-issued nonce - see the header of firestore.rules). So
// `request.auth.uid == ownerId` is a real ownership proof taken straight from the
// path, with no Firestore lookup on the hot path.
//
// Putting the owner in the path rather than reading problems/{problemId}.ownerId
// is what makes "remove-before-publish" work: attachments are uploaded while the
// posting is still an unsaved draft, so there is no posting document to consult
// yet. Ownership is still provable, because it is in the path being written to.
//
// Any signed-in wallet can READ attachments under this prefix. Upload and delete
// stay owner-only. Read does not look up the posting in Firestore: a Storage
// rule that called firestore.get() on problems/{id} refused every non-owner
// download in production (the owner still succeeded via the path), which is the
// 403 on Discover. Keep reads on request.auth only.
//
// ON OBJECT COUNT - what these rules can and cannot do.
// firestore.rules caps a posting's attachment list at 5, but that governs the
// posting record, not the bucket. Storage rules cannot count objects or read a
// running total, so nothing here bounds how many objects one wallet writes. Every
// per-REQUEST property is constrained (owner, type, name, size, metadata); volume
// is not expressible as a rule and is handled outside this file:
//
//   1. App Check enforcement on Cloud Storage - CURRENTLY OFF. reCAPTCHA never
//      mints a token here (zero assessments in 90 days; the provider iframe is
//      denied storage access), so enforcing it refuses every upload. Re-enable
//      only after grecaptcha.enterprise.execute() is confirmed to resolve. It
//      bounds upload VOLUME; access is gated by SIWE and the rules below.
//   2. sweepAttachments (functions/attachmentSweeper.js) deletes objects under
//      this prefix that no posting references. Still needed WITH App Check on,
//      because most orphans are not abuse: a user who uploads and then abandons
//      the form, or closes the tab before publishing, leaves a real file behind
//      through entirely ordinary use. The client deletes what it can on abandon,
//      but it cannot clean up after a closed tab - that is this job's work.
//   3. storage.lifecycle.json aborts incomplete resumable uploads after a day.
//      Covers partial transfers only; completed orphans are (2)'s problem.
//   4. A budget alert, so anything unexpected surfaces as a notification.
service firebase.storage {
  match /b/{bucket}/o {

    // Per-file cap. Mirrored in frontend/src/lib/attachments.js as MAX_FILE_BYTES;
    // the client copy is a courtesy so the user gets an instant error, this copy is
    // the one that is actually enforced.
    function maxBytes() {
      return 10 * 1024 * 1024;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isWallet(address) {
      return isSignedIn() && request.auth.uid == address;
    }

    // BUDGET: Cloud Storage cross-service Rules allow at most TWO Firestore
    // document reads per evaluation. Measured against production: one read
    // passes, two pass, THREE are denied outright - and repeating the same
    // document still counts, so nothing is cached. The previous shape called
    // firestore.get/exists about eleven times through nested helpers, which is
    // why every upload and download 403'd and the bucket stayed empty.
    //
    // So: ONE read of the caller's profile, and at most ONE of the posting.
    // Each function binds its read with `let` and is called at most once per
    // rule. Adding another firestore.get here will break every rule silently -
    // the failure is a bare 403 with no message.

    // Suspension AND revocation from a single read. firestore.get returns null
    // for a missing document rather than failing, so absence is testable.
    //
    // The sessionRevocations document is deliberately NOT read: revokeOwnSessions
    // (functions/index.js) and adminActions both mirror sessionsValidAfterEpoch
    // onto the user document, so the profile carries the same cutoff for a second
    // of the budget rather than a whole read of its own.
    function isActiveMember() {
      let user = firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
      return isSignedIn()
        && user != null
        && !user.data.get('suspended', false)
        // Inclusive, matching hasRevokedSession() in firestore.rules: signing in
        // and out inside the same whole second must still invalidate the token.
        && !(user.data.keys().hasAny(['sessionsValidAfterEpoch'])
          && request.auth.token.auth_time <= user.data.sessionsValidAfterEpoch);
    }

    // Mirrors the problems/{problemId} read rule in firestore.rules, which since
    // QCDAO-48 makes a submitted or open posting readable by any member - that is
    // the public marketplace Discover queries. A draft stays private to its owner.
    //
    // The ownerId comparison is load-bearing, not decoration. Without it, anyone
    // could upload into their OWN folder using a published posting's id
    // (problems/{attacker}/{publishedId}/x.pdf) and have those bytes served to the
    // world on the strength of someone else's posting being public.
    function attachmentRecord(collectionName, recordId) {
      return firestore.get(/databases/(default)/documents/$(collectionName)/$(recordId));
    }

    function postingIsPublished(problemId, ownerId) {
      let posting = attachmentRecord('problems', problemId);
      return posting != null
        && posting.data.status in ['submitted', 'open']
        && posting.data.ownerId == ownerId;
    }

    // A fresh id is always fine - uploadAttachment mints one per transfer. Reusing
    // an id the posting still lists is the swap isReferencedFile exists to refuse.
    // That check is not enough on its own: an owner could unlink the id from
    // Firestore, delete the object, and recreate different bytes at the same
    // path. Delete is therefore frozen once the posting leaves draft (below).
    // Combined, listed ids cannot be rewritten and unlisted published ids cannot
    // be removed from the bucket by the owner, so the marketplace URL stays bound
    // to the original object.
    function postingAcceptsNewFile(problemId, ownerId, fileName) {
      let posting = attachmentRecord('problems', problemId);
      return posting == null
        || (posting.data.ownerId == ownerId && !isReferencedFile(posting, fileName));
    }

    // Remove-before-publish (and the pre-save path where no document exists yet)
    // may still drop objects. Once the posting has been published, those bytes
    // are what reviewers already downloaded and what the opportunity hash named
    // by id/name/size/type. Owner delete stays closed for every non-draft status
    // so unlinking attachments[] cannot reopen the path for a silent swap.
    function postingAllowsFileRemoval(problemId, ownerId) {
      let posting = attachmentRecord('problems', problemId);
      return posting == null
        || (posting.data.ownerId == ownerId
          && posting.data.get('status', '') == 'draft');
    }

    // PDF only, per the story. Two independent checks because they can disagree:
    // contentType is metadata the client supplies, and the object name is the path
    // it writes to. Requiring both closes the case where a caller uploads
    // `payload.html` while declaring `application/pdf`, which would otherwise be
    // served back from a Firebase Storage download URL with an HTML content type.
    //
    // NOTE: neither check inspects the bytes. A determined uploader can still put
    // arbitrary content inside a correctly-named, correctly-typed object; the
    // client checks the %PDF- magic number to catch honest mistakes, but real
    // content inspection means scanning server-side, which QCDAO-58 puts out of
    // scope. That matters MORE than it used to: attachments on a published posting
    // are now readable by anyone, so a malicious file reaches every viewer rather
    // than only its uploader. The app still downloads via getBlob and never renders
    // a PDF inline, which is what keeps this to "unpleasant" rather than "hostile
    // content executing in the reader's browser". Revisit if preview is ever added.
    //
    // fileName and problemId are PARAMETERS, not free variables. Path captures are
    // bound inside their own match block, so a helper declared out here that reads
    // `fileName` directly does not see the path segment - it silently evaluates to
    // nothing and the rule denies everything, including legitimate uploads. Passing
    // them in is what keeps these usable from the match block below.
    function isPdf(fileName) {
      return request.resource.contentType == 'application/pdf'
        && fileName.matches('^[A-Za-z0-9._-]{1,120}[.]pdf$');
    }

    function withinSizeCap() {
      return request.resource.size > 0 && request.resource.size <= maxBytes();
    }

    // Lock the custom metadata the app relies on so a caller cannot write an
    // object whose recorded uploader disagrees with the path it sits in.
    function metadataIsHonest(problemId) {
      return request.resource.metadata != null
        && request.resource.metadata.uploadedBy == request.auth.uid
        && request.resource.metadata.problemId == problemId
        && request.resource.metadata.sha256.matches('^0x[0-9a-f]{64}$');
    }

    // The posting id is a Firestore document id, so bound it to that shape. The
    // match block already guarantees a single path segment, but nothing otherwise
    // stopped a caller from using a 300-character segment as a scratch namespace.
    function isPostingId(problemId) {
      return problemId.matches('^[A-Za-z0-9_-]{1,64}$');
    }

    // Delete-then-upload at the SAME id swaps the bytes behind a digest the record
    // (and the chain) already anchored, which `resource == null` alone does not stop.
    // Two slots, mirroring validAttachments in firestore.rules. Takes the document
    // the caller already read, so it costs no extra cross-service read.
    function isReferencedFile(record, fileName) {
      let items = record.data.get('attachments', []);
      return (items.size() > 0 && fileName == items[0].get('id', '') + '.pdf')
        || (items.size() > 1 && fileName == items[1].get('id', '') + '.pdf');
    }

    match /problems/{ownerId}/{problemId}/{fileName} {
      // Published posting: any signed-in member may download, which is the point
      // of QCDAO-58 - a solution developer needs the technical context to
      // respond. Draft or any other status: owner only. These PDFs carry the
      // sponsor's competitive detail before publication.
      // TWO reads at most: the profile, then the posting. The owner check is a
      // path comparison and costs nothing, and it is evaluated first so an owner
      // reading their own draft never needs the posting lookup.
      allow read: if isActiveMember()
        && (isWallet(ownerId) || postingIsPublished(problemId, ownerId));

      // CREATE ONLY - a stored attachment is immutable for its whole life.
      //
      // With overwrites allowed, an owner could replace an object in place after
      // the posting had been shared: an evaluator reads version 1, the owner
      // silently swaps in version 2 at the same path, and nothing in Firestore or
      // Storage records that the document under review ever changed. Attachments
      // exist to give reviewers technical context, so "the bytes behind this
      // reference never change" is a property worth having.
      //
      // Nothing legitimate is lost: uploadAttachment() mints a fresh id for every
      // transfer, so the client never writes the same path twice. Replacing a file
      // on a draft is delete-then-upload. After publication the object stays.
      //
      // `resource == null` is doing the real work here, NOT the absence of an
      // `update` rule. Storage classifies an overwrite of an existing object as a
      // `create`, so omitting `update` does not stop one - verified against the
      // emulator, where the swap still succeeded until this clause was added.
      // `resource` is the object already at this path, so requiring it to be null
      // is what actually makes the write create-only.
      allow create: if resource == null
        && isWallet(ownerId)
        && isActiveMember()
        && isPostingId(problemId)
        && isPdf(fileName)
        && withinSizeCap()
        && metadataIsHonest(problemId)
        && postingAcceptsNewFile(problemId, ownerId, fileName);

      // Remove-before-publish only. Restricted to the owner for the same reason
      // writes are. Published objects stay in the bucket even after the owner
      // unlinks them from attachments[] - otherwise delete-then-upload at the
      // same {id}.pdf would replace the bytes behind a stable marketplace URL
      // and an unchanged opportunity hash.
      allow delete: if isWallet(ownerId) && isActiveMember()
        && postingAllowsFileRemoval(problemId, ownerId);
    }

    // Proposal files are private to the submitting wallet and the sponsor. A
    // correction may add or drop files; the bytes behind any one id never change.
    // Sponsor reads require a non-draft record so a forged draft
    // `postingOwnerId` cannot open another member's download path.
    function proposalReader(proposalId, ownerId) {
      let proposal = attachmentRecord('proposals', proposalId);
      return proposal != null && proposal.data.researcherId == ownerId
        && proposal.data.status != 'draft'
        && proposal.data.postingOwnerId == request.auth.uid;
    }

    // Drafts (and the pre-save path where no document exists yet) may gain and
    // drop files. Submission is chain-first: commitProposal is mined before the
    // Firestore row becomes `submitted`, so that status already means the
    // attachment bytes are covered by an on-chain solution hash — even when the
    // receipt has not been written yet, and even while it is only `pending`.
    // Freezing later, at `confirmed`, would leave that window open. Create is
    // already create-only (`resource == null`), but that is not enough:
    // delete-then-upload of the same path would replace the PDF without
    // touching Firestore `attachments[]` or the on-chain hashes. A text
    // correction may still rewrite the attachment list in Firestore; it cannot
    // swap the bytes behind an id the sponsor has already downloaded.
    function proposalAcceptsFileChanges(proposalId, ownerId) {
      let proposal = attachmentRecord('proposals', proposalId);
      return proposal == null
        || (proposal.data.researcherId == ownerId
          && proposal.data.status == 'draft');
    }

    match /proposals/{ownerId}/{proposalId}/{fileName} {
      allow read: if isActiveMember() && (isWallet(ownerId) || proposalReader(proposalId, ownerId));
      // Create takes the same gate as delete: submission freezes the prefix, so
      // there is no window in which an id can be re-created with other bytes.
      allow create: if resource == null && isWallet(ownerId) && isActiveMember()
        && isPostingId(proposalId) && isPdf(fileName) && withinSizeCap()
        && metadataIsHonest(proposalId)
        && proposalAcceptsFileChanges(proposalId, ownerId);
      allow delete: if isWallet(ownerId) && isActiveMember()
        && proposalAcceptsFileChanges(proposalId, ownerId);
    }

    // Deny everything not matched above, including any legacy path.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
