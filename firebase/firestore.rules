rules_version = '2';

// Server-side authorisation for wallet onboarding.
//
// The security model rests on one fact: `request.auth.uid` IS the lowercase wallet
// address, and a uid can only exist because firebase/functions/index.js verified a
// signature over a server-issued, single-use nonce before minting the custom token.
// A browser cannot forge one. That is why `request.auth.uid == address` below is a
// real proof of wallet ownership rather than a claim the client made about itself.
//
// `role` is 0 (user) or 1 (administrator) - see frontend/src/lib/roles.js. It is
// fixed to 0 on create and immutable on every client update below, so becoming an
// administrator is only ever done by hand in the Firestore console (or via the
// Admin SDK), which bypasses these rules entirely. No amount of frontend code can
// grant it.
service cloud.firestore {
  match /databases/{database}/documents {

    function isWallet(address) {
      return request.auth != null && request.auth.uid == address;
    }

    // Cutoff for already-issued ID tokens. Written by Cloud Functions on logout and
    // suspension, including when the wallet has not created a /users profile yet.
    // Inclusive: auth_time and the cutoff are whole seconds, so sign-in then logout
    // in the same second must still invalidate that ID token.
    function hasRevokedSession(address) {
      let revocation = /databases/$(database)/documents/sessionRevocations/$(address);
      let profile = /databases/$(database)/documents/users/$(address);
      return (exists(revocation)
          && request.auth.token.auth_time <= get(revocation).data.sessionsValidAfterEpoch)
        || (exists(profile)
          && get(profile).data.keys().hasAny(['sessionsValidAfterEpoch'])
          && request.auth.token.auth_time <= get(profile).data.sessionsValidAfterEpoch);
    }

    function isUnrevokedWallet(address) {
      return isWallet(address) && !hasRevokedSession(address);
    }

    function isActiveUser(address) {
      return isUnrevokedWallet(address)
        && (!exists(/databases/$(database)/documents/users/$(address))
          || !get(/databases/$(database)/documents/users/$(address)).data.get('suspended', false));
    }

    // A completed onboarding record. SIWE mints a token before /users exists, and
    // isActiveUser deliberately still treats that wallet as active so the owner can
    // finish signup. Marketplace reads must not: a posting is competitive detail
    // for registered participants, not for any wallet that completed a signature.
    function hasCompletedProfile(address) {
      return exists(/databases/$(database)/documents/users/$(address));
    }

    function isWalletAddress(value) {
      return value is string && value.matches('^0x[0-9a-f]{40}$');
    }

    function isNonEmptyString(value, maxLength) {
      return value is string && value.size() > 1 && value.size() <= maxLength;
    }

    // Contribution counters must start at zero. A client that could seed its own
    // karma at signup would make the whole reputation system meaningless.
    function statsAreZeroed(stats) {
      return stats.keys().hasOnly([
               'comments', 'businessProblems', 'openFunding',
               'fundingRequests', 'karma', 'reputation'
             ])
             && stats.keys().hasAll([
                  'comments', 'businessProblems', 'openFunding',
                  'fundingRequests', 'karma', 'reputation'
                ])
             && stats.comments == 0
             && stats.businessProblems == 0
             && stats.openFunding == 0
             && stats.fundingRequests == 0
             && stats.karma == 0
             && stats.reputation == 0;
    }

    function expertiseItemIsValid(item) {
      return item is string && item.size() >= 2 && item.size() <= 80;
    }

    function hasExpertiseItems(data) {
      return !data.keys().hasAny(['expertise'])
        || (data.expertise is list
          && data.expertise.size() <= 12
          && (data.expertise.size() < 1 || expertiseItemIsValid(data.expertise[0]))
          && (data.expertise.size() < 2 || expertiseItemIsValid(data.expertise[1]))
          && (data.expertise.size() < 3 || expertiseItemIsValid(data.expertise[2]))
          && (data.expertise.size() < 4 || expertiseItemIsValid(data.expertise[3]))
          && (data.expertise.size() < 5 || expertiseItemIsValid(data.expertise[4]))
          && (data.expertise.size() < 6 || expertiseItemIsValid(data.expertise[5]))
          && (data.expertise.size() < 7 || expertiseItemIsValid(data.expertise[6]))
          && (data.expertise.size() < 8 || expertiseItemIsValid(data.expertise[7]))
          && (data.expertise.size() < 9 || expertiseItemIsValid(data.expertise[8]))
          && (data.expertise.size() < 10 || expertiseItemIsValid(data.expertise[9]))
          && (data.expertise.size() < 11 || expertiseItemIsValid(data.expertise[10]))
          && (data.expertise.size() < 12 || expertiseItemIsValid(data.expertise[11])));
    }

    function hasOptionalProfileFields(data) {
      return (!data.keys().hasAny(['biography'])
              || (data.biography is string && data.biography.size() <= 500))
             && hasExpertiseItems(data);
    }

    match /users/{address} {
      // The exact field set frontend/src/lib/profile.js writes at creation. Locking
      // this with hasOnly() means a client cannot smuggle in an extra field (e.g. a
      // self-granted `isAdmin`) that later code might start trusting without
      // re-checking - the schema is enforced here, not just assumed from the client.
      function hasProfileSchema(data) {
        return data.keys().hasOnly([
          'address', 'fullName', 'organisation', 'biography', 'expertise',
          'role', 'chainId', 'stats',
          'walletVerified', 'termsAcceptedAt', 'termsVersion', 'createdAt', 'updatedAt',
          'suspended', 'sessionsValidAfterEpoch', 'tokenRevocationStatus', 'tokenRevokedAt'
        ]);
      }

      function publicFieldsMatch(data) {
        let publicProfile = getAfter(/databases/$(database)/documents/publicProfiles/$(address)).data;
        return publicProfile.address == data.address
               && publicProfile.fullName == data.fullName
               && publicProfile.organisation == data.organisation
               && publicProfile.keys().hasAny(['biography']) == data.keys().hasAny(['biography'])
               && (!data.keys().hasAny(['biography'])
                   || publicProfile.biography == data.biography)
               && publicProfile.keys().hasAny(['expertise']) == data.keys().hasAny(['expertise'])
               && (!data.keys().hasAny(['expertise'])
                   || publicProfile.expertise == data.expertise);
      }

      // PRIVATE. Only the wallet that owns this document may read it.
      // Note there is no `list` here at all, only `get`.
      allow get: if isUnrevokedWallet(address);

      allow create: if isUnrevokedWallet(address)
        && isWalletAddress(address)
        && hasProfileSchema(request.resource.data)
        && hasOptionalProfileFields(request.resource.data)
        && request.resource.data.address == address
        && isNonEmptyString(request.resource.data.fullName, 80)
        && isNonEmptyString(request.resource.data.organisation, 120)
        // 0 = normal user. Every new account is one - there is no self-service path
        // to 1 (administrator) anywhere in this rule. Becoming an admin means
        // someone with Firestore console access edits this field by hand; nothing
        // the client can send, at signup or ever after, can set it to 1 itself.
        && request.resource.data.role == 0
        // Fixed testnet id for now; this becomes a real chain allow-list if the
        // platform ever supports more than one network.
        && request.resource.data.chainId == 421614
        && statsAreZeroed(request.resource.data.stats)
        // Only reachable at all with a uid a signature verification minted, so this
        // is safe to require outright rather than merely permit.
        && request.resource.data.walletVerified == true
        && isNonEmptyString(request.resource.data.termsVersion, 40)
        && request.resource.data.termsAcceptedAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && !request.resource.data.keys().hasAny(['suspended']);

      // Only the wallet itself may edit its profile, on any device, because the uid
      // is derived from a signature rather than from a per-browser session.
      //
      // `role` and `stats` both have to come back byte-identical. `stats` moves only
      // via the Admin SDK; `role` moves only by hand in the Firestore console - if a
      // signed-in user could ever change their own role, "administrator" would be
      // available to anyone with a browser console, not something granted.
      allow update: if isActiveUser(address)
        && !resource.data.get('suspended', false)
        && resource != null
        && hasProfileSchema(request.resource.data)
        && hasOptionalProfileFields(request.resource.data)
        && request.resource.data.address == resource.data.address
        && request.resource.data.role == resource.data.role
        && request.resource.data.chainId == resource.data.chainId
        && request.resource.data.stats == resource.data.stats
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.termsAcceptedAt == resource.data.termsAcceptedAt
        && request.resource.data.termsVersion == resource.data.termsVersion
        && request.resource.data.walletVerified == resource.data.walletVerified
        && request.resource.data.get('suspended', false) == resource.data.get('suspended', false)
        && request.resource.data.get('sessionsValidAfterEpoch', 0) == resource.data.get('sessionsValidAfterEpoch', 0)
        && request.resource.data.get('tokenRevocationStatus', '') == resource.data.get('tokenRevocationStatus', '')
        && request.resource.data.get('tokenRevokedAt', null) == resource.data.get('tokenRevokedAt', null)
        && isNonEmptyString(request.resource.data.fullName, 80)
        && isNonEmptyString(request.resource.data.organisation, 120)
        && existsAfter(/databases/$(database)/documents/publicProfiles/$(address))
        && publicFieldsMatch(request.resource.data)
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // The deliberately-small public face of a profile: enough to attribute a
    // published problem or an evaluation to someone, and nothing else.
    //
    // Kept as a SEPARATE document rather than a field-level filter on /users because
    // Firestore rules cannot restrict which fields a read returns - `allow get` is
    // all-or-nothing on the whole document. The only way to publish two fields while
    // keeping nine private is to store them apart.
    match /publicProfiles/{address} {
      function hasPublicSchema(data) {
        return data.keys().hasOnly([
          'address', 'fullName', 'organisation', 'biography', 'expertise'
        ]);
      }

      // `get` but NOT `list`: you may look up an address you already have
      allow get: if true;

      // getAfter() reads the /users document as it will be once THIS write commits,
      // which is what lets the two be written together in one batch and still be
      // checked against each other. Without it a verified wallet could create a
      // public record with no account behind it, or drift its public name away from
      // its private profile - making attribution meaningless, since the name shown
      // beside published work would no longer be the name on the account.
      function matchesPrivateProfile(data) {
        let profile = getAfter(/databases/$(database)/documents/users/$(address)).data;
        return profile.address == data.address
               && profile.fullName == data.fullName
             && profile.organisation == data.organisation
             && (!data.keys().hasAny(['biography'])
               || (profile.keys().hasAny(['biography'])
                 && profile.biography == data.biography))
             && (!data.keys().hasAny(['expertise'])
               || (profile.keys().hasAny(['expertise'])
                 && profile.expertise == data.expertise));
      }

      allow create: if isUnrevokedWallet(address)
        && isWalletAddress(address)
        && hasPublicSchema(request.resource.data)
        && (!request.resource.data.keys().hasAny(['biography'])
          || (request.resource.data.biography is string
            && request.resource.data.biography.size() <= 500))
        && hasOptionalProfileFields(request.resource.data)
        && request.resource.data.address == address
        && isNonEmptyString(request.resource.data.fullName, 80)
        && isNonEmptyString(request.resource.data.organisation, 120)
        && existsAfter(/databases/$(database)/documents/users/$(address))
        && matchesPrivateProfile(request.resource.data);

      allow update: if isActiveUser(address)
        && resource != null
        && hasPublicSchema(request.resource.data)
        && (!request.resource.data.keys().hasAny(['biography'])
          || (request.resource.data.biography is string
            && request.resource.data.biography.size() <= 500))
        && hasOptionalProfileFields(request.resource.data)
        && request.resource.data.address == resource.data.address
        && isNonEmptyString(request.resource.data.fullName, 80)
        && isNonEmptyString(request.resource.data.organisation, 120)
        && existsAfter(/databases/$(database)/documents/users/$(address))
        && matchesPrivateProfile(request.resource.data);

      allow delete: if false;
    }

    // Sign-in nonces are written and read only by the Admin SDK inside the callable
    // functions. Exposing them to the browser would let an attacker read a pending
    // nonce, or clear the `consumed` flag and replay a signature.
    match /siweNonces/{address} {
      allow read, write: if false;
    }

    match /sessionRevocations/{address} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------------
    // ACTIVE COLLECTIONS (Document-based authorization & schema validation)
    // ------------------------------------------------------------------------

    // Exactly what buildPostingDocument and the seeder write, and nothing else.
    // Six pre-QCDAO-48 fields (outcomes, deadline, benefits, deliverables, type,
    // opportunityType) were dropped: no writer produces them, and hasOnly compares
    // every document key against every allowed key, so the shorter list is what
    // brings problem writes back under the 1000-expression cap.
    function hasProblemSchema(data) {
      return data.keys().hasOnly([
        'ownerId', 'organisation', 'title', 'summary', 'amount', 'status',
        'businessContext', 'currentApproach', 'currentLimitations',
        'expectedOutcome', 'successCriteria', 'dataAvailability',
        'categories', 'currency', 'expiresAt',
        'attachments', 'audit', 'createdAt', 'updatedAt'
      ]);
    }

    function hasProposalSchema(data) {
      return data.keys().hasOnly([
        'researcherId', 'problemId', 'title', 'summary', 'outcomes', 'amount',
        'status', 'deliverables', 'audit', 'createdAt', 'updatedAt'
      ]) && data.keys().hasAll([
        'researcherId', 'problemId', 'title', 'summary', 'amount', 'status',
        'createdAt', 'updatedAt'
      ]);
    }

    function hasEvaluationSchema(data) {
      return data.keys().hasOnly([
        'evaluatorId', 'proposalId', 'title', 'score', 'feedback', 'status',
        'createdAt', 'updatedAt'
      ]) && data.keys().hasAll([
        'evaluatorId', 'proposalId', 'title', 'score', 'feedback', 'status',
        'createdAt', 'updatedAt'
      ]);
    }

    function hasFundingSchema(data) {
      return data.keys().hasOnly([
        'funderId', 'proposalId', 'problemId', 'title', 'amount', 'status',
        'tranches', 'createdAt', 'updatedAt'
      ]) && data.keys().hasAll([
        'funderId', 'proposalId', 'problemId', 'title', 'amount', 'status',
        'createdAt', 'updatedAt'
      ]);
    }

    function boundedText(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    // QCDAO-75..79 transaction delivery state. Audit verification reads the
    // configured contract; this map is only a resumable receipt/outbox.
    function isBytes32(value) {
      return value is string && value.matches('^0x[0-9a-f]{64}$');
    }

    function hasValidAudit(data) {
      return !data.keys().hasAny(['audit'])
        || (data.audit is map
          // keys().size() == 9, not hasOnly + hasAll on the same nine names. Those
          // two list comparisons cost enough that a posting carrying both an audit
          // receipt and two attachments exceeded Firestore's 1000-expression cap.
          // Equivalent: every one of the nine is checked by name below, so an
          // unknown key can only fit by displacing one, and that check then fails.
          && data.audit.keys().size() == 9
          && data.audit.schemaVersion == 1
          && data.audit.chainId == 421614
          && isBytes32(data.audit.entityId)
          && isBytes32(data.audit.contentHash)
          && data.audit.status in ['queued', 'submitted', 'pending', 'confirmed', 'failed']
          && data.audit.transactionHash is string
          && (data.audit.transactionHash == '' || isBytes32(data.audit.transactionHash))
          && data.audit.blockNumber is int && data.audit.blockNumber >= 0
          && data.audit.attemptCount is int
          && data.audit.attemptCount >= 0 && data.audit.attemptCount <= 3
          && data.audit.lastError is string && data.audit.lastError.size() <= 500
          && (data.audit.status != 'queued'
            || (data.audit.transactionHash == '' && data.audit.blockNumber == 0))
          && (!(data.audit.status in ['submitted', 'pending', 'confirmed'])
            || data.audit.transactionHash != '')
          && (data.audit.status != 'confirmed' || data.audit.blockNumber > 0));
    }

    function stringListItemIsValid(items, index) {
      return items.size() <= index
        || (items[index] is string && items[index].size() > 0 && items[index].size() <= 500);
    }

    function stringListIsValid(items) {
      return items is list && items.size() <= 8
        && stringListItemIsValid(items, 0)
        && stringListItemIsValid(items, 1)
        && stringListItemIsValid(items, 2)
        && stringListItemIsValid(items, 3)
        && stringListItemIsValid(items, 4)
        && stringListItemIsValid(items, 5)
        && stringListItemIsValid(items, 6)
        && stringListItemIsValid(items, 7);
    }

    function validAmount(value) {
      return value is number && value >= 0 && value <= 1000000000;
    }

    // QCDAO-58 - the posting's record of the PDFs stored in Cloud Storage under
    // problems/{ownerId}/{problemId}/. See firebase/storage.rules, which owns the
    // rules for the bytes themselves; this only governs the reference list.
    //
    // The load-bearing check is `path`: it is rebuilt here from the owner and the
    // problem id in the URL rather than trusted from the client. Without that, a
    // user could write an attachment entry on their OWN posting whose path points
    // into someone else's folder, and any later feature that renders the list
    // would happily hand out a reference to a document they cannot read. Storage
    // rules would still refuse the download, but the reference should never exist.
    // `prefix` is built once by the caller, and the fields are read once each with
    // let bindings: this runs up to five times per write and the repeated keys()
    // and string concatenation were a large part of the expression budget.
    // No `path`: it is derived by the client from the owner, the posting and this
    // id, so there is nothing here to forge and nothing to compare. That removed
    // the per-entry string concatenation, which was the most expensive part of
    // this check against Firestore's 1000-expression evaluation cap.
    function attachmentEntry(item) {
      let id = item.get('id', '');
      let size = item.get('size', 0);
      let name = item.get('name', '');
      return item is map
        // Four named fields, all checked below: an unknown key can only fit by
        // displacing one of them, and that one's check then fails.
        && item.keys().size() == 4
        && id is string && id.matches('^[A-Za-z0-9_-]{8,64}$')
        && name is string && name.size() > 0 && name.size() <= 200
        && size is number && size > 0 && size <= 10485760
        && item.get('contentType', '') == 'application/pdf';
    }

    // Two. Rules cannot loop, so every slot is unrolled and costs expressions
    // against Firestore's 1000-per-evaluation cap. Two is what still passes with an
    // audit receipt on the same document; at three, anchoring a posting fails.
    // Mirrored in lib/attachments.js.
    function validAttachments(data) {
      let items = data.get('attachments', []);
      return items is list
        && items.size() <= 2
        && (items.size() < 1 || attachmentEntry(items[0]))
        && (items.size() < 2 || attachmentEntry(items[1]));
    }

    // QCDAO-48 - the technology areas a posting can ask for help in.
    //
    // Domain level, not technique level: a problem owner knows their business
    // problem, not which algorithm family solves it. 'quantum' covers gate-based,
    // annealing and quantum-inspired approaches together, so the sponsor's
    // 09/06/2026 point that non-gate-based work must not be excluded still holds.
    //
    // The set is closed so a posting cannot invent a category and quietly break
    // discovery filters. Mirrored in frontend/src/config/postingCategories.js;
    // frontend/test/unit/posting.test.js checks the two lists agree.
    function allowedCategories() {
      return [
        'ai', 'quantum', 'web3', 'robotics', 'iot', 'data',
        'security', 'cloud', 'simulation', 'optimisation',
        'sustainability', 'other'
      ];
    }

    function validCategories(categories) {
      return categories is list
        && categories.size() <= 6
        // toSet().hasOnly() checks membership for the whole list in one expression.
        // Firestore caps a rule evaluation at 1000 expressions and this file is
        // close to that ceiling, so unrolling six index comparisons here is a cost
        // the budget cannot carry - and this says the same thing more clearly.
        && categories.toSet().hasOnly(allowedCategories());
    }

    function validCurrency(value) {
      return value in ['SGD', 'USD', 'EUR', 'GBP'];
    }

    // Marketplace-visible postings. A submitted or open problem is readable by
    // any active member, so both statuses carry the same completeness contract.
    function isMarketplaceVisible(status) {
      return status in ['submitted', 'open'];
    }

    // The completeness contract for a marketplace-visible posting.
    //
    // Checked on the resulting status rather than only on create, so a posting
    // cannot be created complete and then have its structure stripped by a later
    // update into (or while remaining) submitted or open. Drafts are untouched
    // by this, which is what keeps pre-QCDAO-48 problems editable until they
    // try to become marketplace-visible.
    //
    // Category, currency and expiry *types* stay in validProblem, which runs on
    // every write. This helper owns non-empty text, amount and the organisation
    // binding, and applies only to submitted or open postings - drafts are exempt,
    // which is what lets QCDAO-50 save an unfinished form.
    //
    // A draft's text: same limits, emptiness allowed. Runs INSTEAD of
    // validFundedPosting, never alongside it - doing both put problem writes over
    // Firestore's 1000-expression evaluation cap.
    // Absent reads the same as empty here, and a legacy problem carries none of
    // these fields at all - requiring presence would make those documents
    // uneditable. The type and length bounds are what matter on a draft.
    function draftTextIsBounded(data) {
      return boundedText(data.get('title', ''), 160)
        && boundedText(data.get('summary', ''), 4000)
        && boundedText(data.get('organisation', ''), 120)
        && boundedText(data.get('businessContext', ''), 4000)
        && boundedText(data.get('currentApproach', ''), 4000)
        && boundedText(data.get('currentLimitations', ''), 4000)
        && boundedText(data.get('expectedOutcome', ''), 4000)
        && boundedText(data.get('successCriteria', ''), 4000)
        && boundedText(data.get('dataAvailability', ''), 4000);
    }

    function validFundedPosting(data) {
      // data.get() with a failing default rather than keys().hasAll([...]): a
      // missing field falls back to a value the check below rejects, so presence is
      // covered without building and scanning the document's key list. That hasAll
      // was the single biggest cost here and pushed problem writes past Firestore's
      // 1000-expression evaluation cap.
      return isNonEmptyString(data.get('title', ''), 160)
        && isNonEmptyString(data.get('summary', ''), 4000)
        && isNonEmptyString(data.get('organisation', ''), 120)
        && isNonEmptyString(data.get('businessContext', ''), 4000)
        && isNonEmptyString(data.get('currentApproach', ''), 4000)
        && isNonEmptyString(data.get('currentLimitations', ''), 4000)
        && isNonEmptyString(data.get('expectedOutcome', ''), 4000)
        && isNonEmptyString(data.get('successCriteria', ''), 4000)
        && isNonEmptyString(data.get('dataAvailability', ''), 4000)
        && validCategories(data.get('categories', []))
        && data.get('categories', []).size() >= 1
        && validCurrency(data.get('currency', ''))
        // '' is not a timestamp, so an absent expiry fails here.
        && data.get('expiresAt', '') is timestamp
        && data.get('amount', 0) > 0
        // Sponsor identity is the owner's profile, not a free-text claim.
        && data.get('organisation', '')
          == get(/databases/$(database)/documents/users/$(data.ownerId)).data.organisation;
    }

    function validProblemStatus(status) {
      return status in ['draft', 'submitted', 'open', 'in_review', 'matched', 'funded', 'completed', 'cancelled'];
    }

    function validProblemTransition(before, after) {
      return before == after
        || (before == 'draft' && after in ['submitted', 'open', 'cancelled'])
        || (before == 'submitted' && after in ['open', 'in_review', 'cancelled'])
        || (before == 'open' && after in ['in_review', 'matched', 'cancelled'])
        || (before == 'in_review' && after in ['open', 'matched', 'cancelled'])
        || (before == 'matched' && after in ['funded', 'completed', 'cancelled'])
        || (before == 'funded' && after in ['completed', 'cancelled']);
    }

    function validProblem(data) {
      return hasProblemSchema(data)
        && hasValidAudit(data)
        && isWalletAddress(data.ownerId)
        && validAmount(data.amount)
        && validProblemStatus(data.status)
        // Defaults chosen so an ABSENT field passes and a present-but-wrong one
        // fails, which keeps the meaning of keys().hasAny() without rebuilding the
        // document's key list five more times.
        && validCategories(data.get('categories', []))
        && validCurrency(data.get('currency', 'SGD'))
        && data.get('expiresAt', request.time) is timestamp;
    }

    function validProposalStatus(status) {
      return status in ['draft', 'submitted', 'under_review', 'accepted', 'rejected', 'withdrawn'];
    }

    function validProposalTransition(before, after) {
      return before == after
        || (before == 'draft' && after in ['submitted', 'withdrawn'])
        || (before == 'submitted' && after in ['under_review', 'withdrawn'])
        || (before == 'under_review' && after in ['accepted', 'rejected', 'withdrawn']);
    }

    function validProposal(data) {
      return hasProposalSchema(data)
        && hasValidAudit(data)
        && isWalletAddress(data.researcherId)
        && isNonEmptyString(data.problemId, 128)
        && isNonEmptyString(data.title, 160)
        && isNonEmptyString(data.summary, 4000)
        && validAmount(data.amount)
        && validProposalStatus(data.status)
        && (!data.keys().hasAny(['outcomes']) || stringListIsValid(data.outcomes));
    }

    function validEvaluationStatus(status) {
      return status in ['draft', 'submitted', 'accepted'];
    }

    function validEvaluationTransition(before, after) {
      return before == after
        || (before == 'draft' && after == 'submitted')
        || (before == 'submitted' && after == 'accepted');
    }

    function validEvaluation(data) {
      return hasEvaluationSchema(data)
        && isWalletAddress(data.evaluatorId)
        && isNonEmptyString(data.proposalId, 128)
        && isNonEmptyString(data.title, 160)
        && data.score is number && data.score >= 0 && data.score <= 100
        && data.feedback is string && data.feedback.size() <= 4000
        && validEvaluationStatus(data.status);
    }

    function validFundingStatus(status) {
      return status in ['pledged', 'approved', 'disbursing', 'completed', 'cancelled'];
    }

    function validFundingTransition(before, after) {
      return before == after
        || (before == 'pledged' && after in ['approved', 'cancelled'])
        || (before == 'approved' && after in ['disbursing', 'cancelled'])
        || (before == 'disbursing' && after in ['completed', 'cancelled']);
    }

    function trancheIsValid(tranches, index) {
      return tranches.size() <= index
        || (tranches[index] is map
          && tranches[index].keys().hasOnly(['amount', 'status', 'dueAt'])
          && tranches[index].keys().hasAll(['amount', 'status'])
          && validAmount(tranches[index].amount)
          && tranches[index].status in ['pending', 'released', 'cancelled']
          && (!tranches[index].keys().hasAny(['dueAt']) || tranches[index].dueAt is timestamp));
    }

    function validTranches(tranches) {
      return tranches is list && tranches.size() <= 5
        && trancheIsValid(tranches, 0)
        && trancheIsValid(tranches, 1)
        && trancheIsValid(tranches, 2)
        && trancheIsValid(tranches, 3)
        && trancheIsValid(tranches, 4);
    }

    function validFunding(data) {
      return hasFundingSchema(data)
        && isWalletAddress(data.funderId)
        && isNonEmptyString(data.proposalId, 128)
        && isNonEmptyString(data.problemId, 128)
        && isNonEmptyString(data.title, 160)
        && validAmount(data.amount)
        && validFundingStatus(data.status)
        && (!data.keys().hasAny(['tranches']) || validTranches(data.tranches));
    }

    match /problems/{problemId} {
      // The marketplace is open to MEMBERS, not to the open internet. A submitted
      // or open posting is readable by any active wallet that has finished
      // onboarding (a /users document); a draft stays private to its owner.
      //
      // Authenticated rather than public because a posting carries a sponsor's
      // business context, their limitations and their budget. That is competitive
      // information, and the platform's value is that it circulates among
      // registered participants instead of by forwarded email. Requiring a session
      // also matches the posting detail route, which has always required one.
      allow read: if isActiveUser(request.auth.uid)
        && (resource.data.ownerId == request.auth.uid
          || (resource.data.status in ['submitted', 'open']
            && hasCompletedProfile(request.auth.uid)));
      allow delete: if isActiveUser(request.auth.uid) && resource.data.ownerId == request.auth.uid;
      allow create: if isActiveUser(request.auth.uid)
        && isWalletAddress(request.auth.uid)
        && request.resource.data.ownerId == request.auth.uid
        && validProblem(request.resource.data)
        && validAttachments(request.resource.data)
        // QCDAO-48 posts straight to 'submitted'; 'draft' stays for anything that
        // saves before it is complete. Nothing else may be created directly - a
        // posting cannot start life already open, matched or funded.
        && request.resource.data.status in ['draft', 'submitted']
        && (isMarketplaceVisible(request.resource.data.status)
          ? (validFundedPosting(request.resource.data)
            // Expiry is the window solution developers respond within, so a
            // posting that arrives already expired is a mistake, not a state.
            && request.resource.data.expiresAt > request.time)
          : draftTextIsBounded(request.resource.data))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isActiveUser(request.auth.uid)
        && resource != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && validProblem(request.resource.data)
        && validAttachments(request.resource.data)
        // ONLY a draft may be incomplete. Keying this off isMarketplaceVisible()
        // let in_review, matched, funded, completed and cancelled take the draft
        // branch, so a posting could be blanked on its way through those states.
        && (request.resource.data.status == 'draft'
          ? draftTextIsBounded(request.resource.data)
          : validFundedPosting(request.resource.data))
        // Publishing a draft needs a live expiry. A draft can sit past its own
        // deadline, and it must not go to the marketplace already closed.
        && (resource.data.status != 'draft'
          || !isMarketplaceVisible(request.resource.data.status)
          || request.resource.data.expiresAt > request.time)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && validProblemTransition(resource.data.status, request.resource.data.status);
    }
    
    match /proposals/{proposalId} {
      allow read: if isActiveUser(request.auth.uid) && resource.data.researcherId == request.auth.uid;
      allow delete: if isActiveUser(request.auth.uid) && resource.data.researcherId == request.auth.uid;
      allow create: if isActiveUser(request.auth.uid)
        && isWalletAddress(request.auth.uid)
        && request.resource.data.researcherId == request.auth.uid
        && validProposal(request.resource.data)
        && request.resource.data.status == 'draft'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/problems/$(request.resource.data.problemId));
      allow update: if isActiveUser(request.auth.uid)
        && resource != null
        && resource.data.researcherId == request.auth.uid
        && request.resource.data.researcherId == resource.data.researcherId
        && request.resource.data.problemId == resource.data.problemId
        && validProposal(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && validProposalTransition(resource.data.status, request.resource.data.status)
        && exists(/databases/$(database)/documents/problems/$(request.resource.data.problemId));
    }
    
    match /evaluations/{evaluationId} {
      allow read: if isActiveUser(request.auth.uid) && resource.data.evaluatorId == request.auth.uid;
      allow delete: if isActiveUser(request.auth.uid) && resource.data.evaluatorId == request.auth.uid;
      allow create: if isActiveUser(request.auth.uid)
        && isWalletAddress(request.auth.uid)
        && request.resource.data.evaluatorId == request.auth.uid
        && validEvaluation(request.resource.data)
        && request.resource.data.status == 'draft'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/proposals/$(request.resource.data.proposalId));
      allow update: if isActiveUser(request.auth.uid)
        && resource != null
        && resource.data.evaluatorId == request.auth.uid
        && request.resource.data.evaluatorId == resource.data.evaluatorId
        && request.resource.data.proposalId == resource.data.proposalId
        && validEvaluation(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && validEvaluationTransition(resource.data.status, request.resource.data.status)
        && exists(/databases/$(database)/documents/proposals/$(request.resource.data.proposalId));
    }
    
    match /funding/{fundId} {
      allow read: if isActiveUser(request.auth.uid) && resource.data.funderId == request.auth.uid;
      allow delete: if isActiveUser(request.auth.uid) && resource.data.funderId == request.auth.uid;
      allow create: if isActiveUser(request.auth.uid)
        && isWalletAddress(request.auth.uid)
        && request.resource.data.funderId == request.auth.uid
        && validFunding(request.resource.data)
        && request.resource.data.status == 'pledged'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/proposals/$(request.resource.data.proposalId))
        && exists(/databases/$(database)/documents/problems/$(request.resource.data.problemId))
        && get(/databases/$(database)/documents/proposals/$(request.resource.data.proposalId)).data.problemId == request.resource.data.problemId;
      allow update: if isActiveUser(request.auth.uid)
        && resource != null
        && resource.data.funderId == request.auth.uid
        && request.resource.data.funderId == resource.data.funderId
        && request.resource.data.proposalId == resource.data.proposalId
        && request.resource.data.problemId == resource.data.problemId
        && validFunding(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && validFundingTransition(resource.data.status, request.resource.data.status)
        && exists(/databases/$(database)/documents/proposals/$(request.resource.data.proposalId))
        && exists(/databases/$(database)/documents/problems/$(request.resource.data.problemId))
        && get(/databases/$(database)/documents/proposals/$(request.resource.data.proposalId)).data.problemId == request.resource.data.problemId;
    }
    
    match /audits/{auditId} {
      allow read: if request.auth != null
        && isUnrevokedWallet(request.auth.uid)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 1
        && !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('suspended', false);
    }

    // Deny everything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
