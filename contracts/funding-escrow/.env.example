ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=

# Explicitly set the factory owner (fee recipient) and authorised workflow signer.
# Owner must equal the deployment signer for one-time wiring. Platform may differ.
# No faucet key is needed. Existing tokens are reused.
ESCROW_OWNER_ADDRESS=
ESCROW_PLATFORM_SIGNER_ADDRESS=
# New linked registry deployment needs a planned application migration.
ESCROW_NEW_REGISTRY_ACK=false
# 10 / 10000 = 0.1%, charged only on a successful release.
ESCROW_FEE_BPS=10
# Existing six-decimal mock XSGD, USDT, USDC from ../stable-faucet/README.md.
ESCROW_TOKEN_ADDRESSES=0xC2FE292771719Ae948506bab3c156A622de9a415,0x5f079A5934C864D6881EF30cf74Fe1363F58B856,0x4CBf2C15243678206dF8F248D01a0e117C8ce0cd
